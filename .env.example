# Bun carrega .env automaticamente. Os valores abaixo são os defaults do código (docker compose local).
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=wager
DATABASE_PASSWORD=wager
DATABASE_NAME=wager
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
# Visibility timeout pedido no ReceiveMessage (segundos)
SQS_VISIBILITY_TIMEOUT=30
# false = só API HTTP (sem consumidor SQS, publisher da outbox e worker de PENDING_REFERENCE)
WORKERS_ENABLED=true
